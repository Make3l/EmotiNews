<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.majkel.emotinews.ui.controller.MainViewController"
           stylesheets="@../style/style.css"
           dividerPositions="0.5"
           fx:id="rootSplit">

        <VBox alignment="CENTER" spacing="11" styleClass="left-panel" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" minWidth="300">
            <HBox alignment="CENTER" spacing="10" styleClass="filter-box">
                <Button onAction="#handleAll" styleClass="filter-button" text="All" />
                <Button onAction="#handlePositive" styleClass="filter-button" text="Positive" />
                <Button onAction="#handleNegative" styleClass="filter-button" text="Negative" />
                <Button onAction="#handleNeutral" styleClass="filter-button" text="Neutral" />
            </HBox>

            <StackPane>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Loading news... " managed="false" visible="false" fx:id="loadingLabel"/>
                    <ProgressIndicator prefHeight="20" prefWidth="20" fx:id="loadingSpinner" visible="false" managed="false"/>
                </HBox>

                <HBox alignment="CENTER" spacing="10">
                    <TextField fx:id="topicField" prefWidth="300" promptText="Enter topic..." styleClass="topic-field" />
                    <Button fx:id="searchButton" onAction="#searchTopic" styleClass="search-button" text="Search" />
                </HBox>
            </StackPane>

            <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                <ListView fx:id="listViewObj" styleClass="article-list"/>
            </ScrollPane>
        </VBox>
</SplitPane>